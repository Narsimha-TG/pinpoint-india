# Server-only key. Enable Places API (New) and Geocoding API; restrict this key to your server/IP where possible.
GOOGLE_MAPS_API_KEY=

# Browser key. Enable Maps JavaScript API and restrict by HTTP referrer to your deployed domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Canonical origin used for metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
